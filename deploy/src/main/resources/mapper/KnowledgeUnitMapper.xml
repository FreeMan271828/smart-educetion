<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.nuist.mapper.KnowledgeUnitMapper">

    <resultMap id="BaseResultMap" type="org.nuist.po.KnowledgeUnitPO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="subject" property="subject" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="INTEGER"/>

        <!-- 简化映射 -->
        <result column="created_at" property="createdAt" jdbcType="TIMESTAMP"/>
    </resultMap>

    <select id="selectBySubjectAndStatusPage" resultMap="BaseResultMap">
        SELECT
        id,
        name,
        subject,
        status,
        created_at
        FROM knowledge_unit
        WHERE subject = #{subject}
        AND status = #{status}
        ORDER BY id
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 计数SQL -->
    <select id="countBySubjectAndStatus" resultType="long">
        SELECT COUNT(1)
        FROM knowledge_unit
        WHERE subject = #{subject}
          AND status = #{status}
    </select>


    <!-- 按状态分页查询 -->
    <select id="selectByStatusPage" resultMap="BaseResultMap">
        SELECT id, name, subject, status, created_at
        FROM knowledge_unit
        WHERE status = #{status}
        ORDER BY id
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 按状态计数 -->
    <select id="countByStatus" resultType="long">
        SELECT COUNT(1)
        FROM knowledge_unit
        WHERE status = #{status}
    </select>
</mapper>